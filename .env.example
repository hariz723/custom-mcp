# ==============================================================================
# Custom Playwright MCP Server Configuration
# ==============================================================================

# Server Network Settings
MCP_SERVER_NAME=custom-playwright
MCP_TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000

# Browser Runtime Settings
HEADLESS=true
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
DEFAULT_TIMEOUT_MS=30000
OUTPUT_DIR=/app/output

# ==============================================================================
# Autonomous Code Generation & Self-Healing LLM Settings
# ==============================================================================

# General LLM Settings
LLM_MODEL=gemini/gemini-2.5-flash
LLM_TEMPERATURE=0.1
MAX_RETRIES=3

# --- Provider 1: Google Gemini (Cloud) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Provider 2: LM Studio (100% Local & Offline) ---
# If running without Docker:
# LM_STUDIO_API_BASE=http://localhost:1234/v1
# If running inside Docker:
# LM_STUDIO_API_BASE=http://host.docker.internal:1234/v1
# LLM_MODEL=qwen2.5-coder-7b-instruct

# --- Provider 3: OpenAI / Compatible (Cloud) ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1

# --- Provider 4: Ollama (Local) ---
# OLLAMA_API_BASE=http://localhost:11434
